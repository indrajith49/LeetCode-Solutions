-------------------------------------CORE IDEA---------------------------------------------
so the core idea is we will keep appending on our stack with the help of loop and if the token is any operator for example "*/+-" we will pop out from the stack and do the operation. we have to make sure that the operators come first before appending int(token)




class Solution:
    def evalRPN(self, tokens):
        stack = []  # ← Use a meaningful name like 'stack'

        for token in tokens:
            if token == "+":
                b = stack.pop()  # Pop second number
                a = stack.pop()  # Pop first number
                stack.append(a + b)
            elif token == "-":
                b = stack.pop()
                a = stack.pop()
                stack.append(a - b)
            elif token == "*":
                b = stack.pop()
                a = stack.pop()
                stack.append(a * b)
            elif token == "/":
                b = stack.pop()
                a = stack.pop()
                stack.append(int(a / b))  # Truncate toward zero
            else:
                stack.append(int(token))  # It's a number!

        return stack[0]  # Final answer
